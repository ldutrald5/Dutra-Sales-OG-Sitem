#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
const result = process.platform === 'win32' ? spawnSync(process.env.ComSpec || 'cmd.exe', ['/d', '/s', '/c', 'npm.cmd run og:check'], { stdio: 'inherit' }) : spawnSync('npm', ['run', 'og:check'], { stdio: 'inherit' });
process.exit(result.status ?? 1);

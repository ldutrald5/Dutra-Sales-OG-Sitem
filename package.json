{
  "name": "meu-projeto-aiox",
  "version": "0.1.0",
  "private": true,
  "description": "Projeto AIOX em português — Sistema OG / Dutra Sales",
  "scripts": {
    "aiox": "aiox-core",
    "aiox:version": "aiox-core --version",
    "aiox:doctor": "aiox-core doctor",
    "aiox:config-check": "aiox-core config validate",
    "og:start": "node apps/sistema-og/server.mjs",
    "og:start:lan": "node apps/sistema-og/server.mjs",
    "og:cloud:dev": "wrangler dev",
    "og:cloud:deploy": "wrangler deploy",
    "og:assets": "node scripts/optimize-og-assets.mjs",
    "og:call-ai:test": "node scripts/test_call_ai.mjs",
    "og:check": "node --check apps/sistema-og/app.js && node --check apps/sistema-og/data.js && node --check apps/sistema-og/server.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "aiox-core": "5.4.1",
    "husky": "^9.1.7",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
